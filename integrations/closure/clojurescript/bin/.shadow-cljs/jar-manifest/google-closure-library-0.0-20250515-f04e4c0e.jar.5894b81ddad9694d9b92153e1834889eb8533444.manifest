 or values to a protocol buffer string.\n * @constructor\n * @extends {goog.json.Serializer}\n * @final\n */\ngoog.proto.Serializer = function() {\n  'use strict';\n  goog.json.Serializer.call(this);\n};\ngoog.inherits(goog.proto.Serializer, goog.json.Serializer);\n\n\n/**\n * Serializes an array to a protocol buffer string. This overrides the JSON\n * method to don't output trailing null or undefined.\n * @param {Array<*>} arr The array to serialize.\n * @param {Array<string>} sb Array used as a string builder.\n * @override\n */\ngoog.proto.Serializer.prototype.serializeArray = function(arr, sb) {\n  'use strict';\n  const l = arr.length;\n  sb.push('[');\n  let emptySlots = 0;\n  let sep = '';\n  for (let i = 0; i < l; i++) {\n    if (arr[i] == null) {  // catches undefined as well\n      emptySlots++;\n    } else {\n      sb.push(sep);\n      if (emptySlots > 0) {\n        sb.push(goog.string.repeat('null,', emptySlots));\n        emptySlots = 0;\n      }\n      this.serializeInternal(arr[i], sb);\n      sep = ',';\n    }\n  }\n  sb.push(']');\n};\n","^1O",1778794118123,"^1P",["^1:",["~$goog.string","^1?","~$goog.json.Serializer"]],"^1Q",["^ ","^1R","The Google Closure Library is a collection of JavaScript code\n        designed for use with the Google Closure JavaScript Compiler.\n\n        This non-official distribution was prepared by the ClojureScript\n        team at http://clojure.org/","^1S","^1T","^1U","^1V","^1W","Google Closure Library","^1X","^1Y","^1Z","http://code.google.com/p/closure-library/","^1[","^20","^21",["^1Y","0.0-20250515-f04e4c0e"],"^22","0.0-20250515-f04e4c0e"],"^23",["^1:",["^RS","^RT"]],"^24",["^ ","^25",[],"^26",false,"^27",[],"^28",[],"^1C",["goog.proto.Serializer"],"^29","es6","^1D",null,"^1G",false,"^2:",[],"^2;",[],"^2<",[],"^23",["goog.json.Serializer","goog.string"],"^2=",[],"^19",[],"^2>",false,"^2?",false,"^2@",false],"^1Z",["^2A","jar:file:/home/anatoly/.m2/repository/org/clojure/google-closure-library/0.0-20250515-f04e4c0e/