PES=} templateData The data for the template.\n * @param {?Object=} injectedData The injected data for the template.\n * @return {string}\n * @template ARG_TYPES\n */\nfunction renderAsText(\n    template, templateData = undefined, injectedData = undefined) {\n  const result = template(templateData || defaultTemplateData, injectedData);\n  asserts.assertString(\n      result,\n      'renderText was called with a template of kind other than \"text\"');\n  return String(result);\n}\nexports.renderAsText = renderAsText;\n\n/**\n * Immutable object that is passed into templates that are rendered\n * without any data.\n * @const\n */\nconst defaultTemplateData = {};\n","^?",1778794118123,"^@",["^3",["^1=","^1>","^1@","^A","^1W","~$goog.soy.data.SanitizedContent","^2O","^1E"]],"^B",["^ ","^C","The Google Closure Library is a collection of JavaScript code\n        designed for use with the Google Closure JavaScript Compiler.\n\n        This non-official distribution was prepared by the ClojureScript\n        team at http://clojure.org/","^D","^E","^F","^G","^H","Google Closure Library","^I","^J","^K","http://code.google.com/p/closure-library/","^L","^M","^N",["^J","0.0-20250515-f04e4c0e"],"^O","0.0-20250515-f04e4c0e"],"^P",["^3",["^1=","^1>","^1@","^1W","^B=","^2O","^1E"]],"^Q",["^ ","^R",[],"^S",false,"^T",[],"^U",[],"^2",[],"^V","es6","^4","goog.soy","^7",true,"^W",[],"^X",[],"^Y",[],"^P",["goog.dom.NodeType","goog.html.SafeHtml","goog.soy.data.SanitizedContent","goog.dom.TagName","goog.asserts","goog.dom","goog.dom.safe"],"^Z",[],"^[",["goog.soy.data.SanitizedHtml"],"^10",false,"^11",false,"^12",false],"^K",["^13","jar:file:/home/anatoly/.m2/repository/org/clojure/google-closure-library/0.0-20250515-f04e4c0e/google-closure-library-0.0-20250515-f04e4c0e.jar!/goog/soy/soy.js"],"^14",["^3",["^B<"]],"^[",["^3",["~$goog.soy.data.SanitizedHtml"]],"^15",true,"^16",true,"^17",["^A","^1@","^2O","^B=","^1E","^1=","^1>","^1W"]],["^ ","^1",["5894b81ddad9694d9b92153e1834889eb8533444