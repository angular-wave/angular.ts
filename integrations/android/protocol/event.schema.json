{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://angular-wave.github.io/angular.ts/native/event.schema.json",
  "title": "Angular Native event",
  "type": "object",
  "required": ["protocol", "target", "event"],
  "properties": {
    "protocol": { "const": 1 },
    "target": { "type": "string", "minLength": 1 },
    "event": { "type": "string", "minLength": 1 },
    "data": {}
  },
  "additionalProperties": false
}
