<?xml version="1.0" encoding="utf-8"?>
<io.github.angularwave.android.navigation.views.AngularNativeView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/angular_native_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/angular_native_web_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:minHeight="400dp">

        <!-- WebView get attached/detached here -->

    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/angular_native_progress_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="400dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- Custom progress view added/removed here -->

    </FrameLayout>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/angular_native_screenshot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:scaleType="matrix"
        tools:ignore="ContentDescription" />

    <FrameLayout
        android:id="@+id/angular_native_error_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:minHeight="400dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- Custom error view added/removed here -->

    </FrameLayout>

</io.github.angularwave.android.navigation.views.AngularNativeView>
